# Copy to .env and run:  uvicorn app.main:app --reload --env-file .env
# Every setting is optional.

# AI explanations. Without a key the app uses its built-in explanations
# (shown with a "Built-in tips" tag) and never proposes fixes.
OPENAI_API_KEY=

# Model and endpoint (any OpenAI-compatible chat-completions API works).
LUMEN_AI_MODEL=gpt-4o-mini
# LUMEN_AI_API_URL=https://api.openai.com/v1/chat/completions
# LUMEN_AI_TIMEOUT=12

# Frontend origin(s) allowed to call this API, comma-separated.
# Defaults to the Vite dev server (http://localhost:5173). Use * only for demos.
# CORS_ORIGINS=https://your-frontend.example.com
